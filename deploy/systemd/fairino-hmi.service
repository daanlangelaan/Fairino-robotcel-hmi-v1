[Unit]
Description=Fairino Robotcel HMI
After=network-online.target fairino-camera.service
Wants=network-online.target fairino-camera.service

[Service]
Type=simple
WorkingDirectory=/opt/fairino-robotcel-hmi
EnvironmentFile=-/etc/fairino-hmi.env
ExecStart=/usr/bin/node tools/start-hmi.mjs --mode modbus
Restart=on-failure
RestartSec=3
User=fairino
Group=fairino
SupplementaryGroups=video
StateDirectory=fairino-hmi
StateDirectoryMode=0750
UMask=0027

[Install]
WantedBy=multi-user.target
