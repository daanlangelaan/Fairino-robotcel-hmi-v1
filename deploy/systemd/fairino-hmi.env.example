# Copy this file to /etc/fairino-hmi.env and adjust the values for the cell.
PORT=8787
HMI_BIND_HOST=127.0.0.1
HMI_BRIDGE_MODE=modbus
HMI_OUTPUT_TESTS_ENABLED=false

# Lua updates its heartbeat between states. Blocking robot motion may keep one
# state active longer than the normal idle interval.
HMI_LUA_HEARTBEAT_IDLE_TIMEOUT_MS=5000
HMI_LUA_HEARTBEAT_MOTION_TIMEOUT_MS=30000

# Enable only after the camera view and service permissions are commissioned.
HMI_CAMERA_ENABLED=false
HMI_CAMERA_DEVICE=/dev/v4l/by-id/usb-Jieli_Technology_USB_Composite_Device-video-index0
HMI_CAMERA_STORAGE_DIR=/var/lib/fairino-hmi/camera
HMI_CAMERA_INPUT_FORMAT=mjpeg
HMI_CAMERA_WIDTH=1920
HMI_CAMERA_HEIGHT=1080
HMI_CAMERA_FPS=25
HMI_CAMERA_SOURCE_PORT=8788
HMI_CAMERA_SOURCE_BASE_URL=http://127.0.0.1:8788/
HMI_CAMERA_SOURCE_URL=http://127.0.0.1:8788/stream
HMI_CAMERA_SOURCE_STATE_URL=http://127.0.0.1:8788/state
HMI_CAMERA_BUFFER_SECONDS=120
HMI_CAMERA_POSTFAULT_SECONDS=10
HMI_CAMERA_SEGMENT_SECONDS=4
HMI_CAMERA_RETENTION_DAYS=30
HMI_CAMERA_MAX_INCIDENTS=50

FAIRINO_HOST=192.168.58.2
FAIRINO_PORT=502
FAIRINO_RPC_PORT=20003
FAIRINO_UNIT_ID=1
FAIRINO_PROGRAM_NAME=mini_cell_production_m31_latest.lua

# M31 Remote IO Modbus TCP reachability indicator in the HMI header.
M31_REMOTE_IO_HOST=192.168.58.7
M31_REMOTE_IO_PORT=502
M31_REMOTE_IO_TIMEOUT_MS=1200
