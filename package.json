{
  "name": "fairino-robotcel-hmi",
  "version": "1.0.0",
  "private": true,
  "description": "Fairino FR5 robotcel HMI bridge and browser interface.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node tools/start-hmi.mjs",
    "start:mock": "node tools/start-hmi.mjs --mode mock",
    "start:modbus": "node tools/start-hmi.mjs --mode modbus",
    "check": "node --check hmi/server.mjs && node --check tools/start-hmi.mjs",
    "probe:modbus": "node tools/modbus_probe.mjs"
  },
  "dependencies": {}
}
